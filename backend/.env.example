APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/clausecite

FRONTEND_ORIGIN=http://localhost:5173

# ChromaDB — embedded persistent mode
CHROMA_PERSIST_PATH=./chroma_db
CHROMA_LEGAL_COLLECTION=legal_corpus
CHROMA_DOCS_COLLECTION=user_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_MODEL=gemini-2.0-flash

# File storage
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=25

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=10080
